{
  "manifest_version": 3,
  "name": "GHA++",
  "version": "0.1.2",
  "description": "Improves the GitHub Actions job experience.",
  "icons": {
    "128": "icons/ghaplusplus.png"
  },
  "permissions": ["storage"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "GHA++",
    "default_icon": "icons/ghaplusplus.png",
    "default_popup": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "https://github.com/*",
    "https://*.blob.core.windows.net/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["dist/live-bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://github.com/*"],
      "js": [
        "dist/vendor/react.js",
        "dist/vendor/react-dom.js",
        "dist/app.js",
        "dist/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "worker-host.html",
        "dist/worker-host.js",
        "dist/log-worker.js",
        "dist/wasm/*"
      ],
      "matches": ["https://github.com/*"]
    }
  ]
}
